# Application identity, startup URL and window floor for TMA.
#
# The values themselves live in //tma.conf, which scripts/setup_chromium.sh
# reads and appends to GN_ARGS -- so these declare_args() defaults are only a
# fallback for a bare `gn gen` run without setup. Keep them equal to what
# tma.conf ships; setup overwrites them on every run, so a mismatch can only
# survive if someone edits one file and not the other.
#
# Everything here is compile-time on purpose. The output binary is named
# <tma_app_name>, and a process cannot rename its own file by reading a
# config, so the name has to be decided before the link. The startup URL and
# the window floor follow the same reasoning: TMA takes no command-line
# argument at all, so what the window opens and how small it may get are
# properties of the binary rather than of how it happened to be invoked.
#
# See //tma/BUILD.gn for where each one lands.

declare_args() {
  # Output binary name. No path separators.
  tma_app_name = "tma"

  # Wayland xdg_toplevel app_id. Compositors match this against the
  # Exec= line of a .desktop file, so it should look like a reverse-DNS id
  # once this is shipped as something other than "tma".
  tma_app_id = "tma"

  # The one URL the window opens. setup_chromium.sh owns the format of the
  # `startup` key in tma.conf and strips its "url:" prefix, so this file never
  # has to interpret a string. Empty only if someone hand-edits args.gn:
  # setup rejects a config that does not state a URL.
  tma_startup_url = "https://example.com"

  # Smallest the window may be, in pixels -- the client (web content) area.
  # The strip TMA draws along the top adds to the height on top of this.
  tma_min_width = 320
  tma_min_height = 200
}
