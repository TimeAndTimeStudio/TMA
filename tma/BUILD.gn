# TMA — Time Mini App.
#
# This BUILD.gn lives at the root of a Chromium checkout as //tma/BUILD.gn. GN
# only follows dependency paths out of //BUILD.gn, so scripts/setup_chromium.sh
# appends a `group("tma_hook")` to that file to pull this one into the build
# graph — without it `ninja tma` reports `unknown target 'tma'`.
#
# The resource bundle is NOT defined here: the embedder loads whatever sits at
# `content_shell.pak` (//content/shell/app/shell_main_delegate.cc:400,422) and
# GN refuses two targets with the same output, so TMA's trimmed file list lives
# in //tma/tma_pak.gni and setup injects it into the existing repack in
# //content/shell/BUILD.gn instead of adding a second producer.
#
#   autoninja -C out/Default tma

import("//build/config/features.gni")
import("//build/config/ozone.gni")
import("//build/config/ui.gni")
import("//tma/tma_config.gni")

assert(is_linux, "TMA only supports Linux.")
assert(toolkit_views, "TMA requires the views toolkit (USE_AURA on Linux).")
assert(ozone_platform_wayland, "TMA requires the Ozone Wayland platform.")
assert(tma_app_name != "", "app_name in tma.conf is empty.")
assert(tma_startup_url != "", "startup in tma.conf must be 'url:<url>'.")
assert(tma_min_width > 0 && tma_min_height > 0,
       "min_width / min_height in tma.conf must be positive integers.")
assert(tma_chromium_version != "",
       "CHROMIUM_VERSION is empty; --version has nothing to report.")

# The character check (letters, digits, '.', '_', '-') lives in
# scripts/tma_conf.sh, where it can name the offending value; GN has no string
# method syntax to express it, so only the empty case is asserted here.

config("tma_warnings") {
  # TMA is embedder code, not Chromium code; keep -Werror off so that future
  # compiler/Wall changes cannot break the out-of-tree build.
  defines = []
}

# Application identity read from //tma.conf, inlined as preprocessor defines
# (see //tma/tma_config.gni for why it is build-time). The binary has no other
# way to learn its own name, so these have to be constants.
config("tma_identity") {
  defines = [
    "TMA_APP_NAME=\"$tma_app_name\"",
    "TMA_APP_ID=\"$tma_app_id\"",
    "TMA_STARTUP_URL=\"$tma_startup_url\"",
    "TMA_MIN_WIDTH=$tma_min_width",
    "TMA_MIN_HEIGHT=$tma_min_height",
    "TMA_CHROMIUM_VERSION=\"$tma_chromium_version\"",
  ]
}

source_set("tma_shell") {
  testonly = true

  sources = [
    "app/tma_main_delegate.cc",
    "app/tma_main_delegate.h",
    "browser/tma_browser_main_parts.cc",
    "browser/tma_browser_main_parts.h",
    "browser/tma_caption_button.cc",
    "browser/tma_caption_button.h",
    "browser/tma_content_browser_client.cc",
    "browser/tma_content_browser_client.h",
    "browser/tma_dark_mode.cc",
    "browser/tma_dark_mode.h",
    "browser/tma_frame_view.cc",
    "browser/tma_frame_view.h",
    "browser/tma_fullscreen.cc",
    "browser/tma_fullscreen.h",
    "browser/tma_metrics.h",
    "browser/tma_platform_delegate.cc",
    "browser/tma_platform_delegate.h",
    "browser/tma_view.cc",
    "browser/tma_view.h",
    "browser/tma_widget_delegate.cc",
    "browser/tma_widget_delegate.h",
  ]

  configs += [
    ":tma_identity",
    ":tma_warnings",
  ]

  deps = [
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//content/shell:content_shell_lib",
    "//net",
    "//net:net_resources",
    "//third_party/abseil-cpp:absl",
    "//ui/aura",
    "//ui/base",
    "//ui/color:color_headers",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/native_theme",
    "//ui/resources",
    "//ui/views",
    "//ui/views:test_support",
    "//ui/views/controls/webview",
    "//ui/wm",
    "//url",
  ]

  if (use_dbus) {
    # tma_dark_mode.cc reads org.freedesktop.appearance over D-Bus so that
    # pages get a correct prefers-color-scheme. //content/shell has no
    # equivalent of ChromeBrowserMainExtraPartsViewsLinux's dark mode manager,
    # and the one upstream class that does exist cannot deliver the value
    # without a GTK LinuxUiTheme, so an embedder has to do it.
    deps += [
      "//components/dbus",
      "//dbus",
    ]
  }
}

executable("tma") {
  testonly = true

  # Only the file on disk follows app_name; the GN target is left as "tma" so
  # that `autoninja -C <out> tma` and build_tma.sh do not have to know it.
  output_name = tma_app_name

  sources = [ "app/tma_main.cc" ]

  deps = [
    ":tma_shell",
    "//content/public/app",
    "//content/shell:content_shell_app",
    "//content/shell:content_shell_lib",
    "//content/shell:pak",
    "//sandbox",
  ]

  data_deps = [
    "//components/crash/core/app:chrome_crashpad_handler",
    "//content/shell:pak",
    "//tools/v8_context_snapshot",
  ]

  # tma_main.cc reads TMA_APP_NAME and TMA_CHROMIUM_VERSION for --version;
  # tma_shell already carries this, the executable needs it in its own right.
  configs += [ ":tma_identity" ]

  if (!is_component_build) {
    configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  }
}
